# Loopback origin for Cloudflare Tunnel (or any local reverse proxy).
# Public TLS stays on the tunnel; this site never binds a public address.
# Upstream file is rewritten atomically by host-slot-deploy.sh.

http://127.0.0.1:8080 {
	import /etc/zl-expense/caddy/upstream.caddy
	log {
		output discard
	}
}
